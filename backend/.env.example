# Copy to backend/.env (which git ignores) and fill in.
DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban

# --- Claude Code agent (optional; the fake agent needs none of this) ---
# Your own Anthropic API key. Agent runs are billed to it.
# KANBAN_ANTHROPIC_API_KEY=sk-ant-...
# The most one run may spend, in dollars (default 1.00)
# CLAUDE_MAX_BUDGET_USD=1.00
# Model alias (default: the CLI's own default)
# CLAUDE_MODEL=sonnet
# The CLI to run (default: claude) and where it keeps its own settings
# CLAUDE_BIN=claude
# KANBAN_CLAUDE_CONFIG_DIR=~/.config/kanban-agents/claude
